{
  "title": "Graphiti Overview",
  "uid": "graphiti-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Spans (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "SELECT count(*) AS value FROM opentelemetry_traces WHERE timestamp > now() - INTERVAL '1h'",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "HTTP Requests (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "SELECT count(*) AS value FROM opentelemetry_traces WHERE span_name = 'http.server.request' AND timestamp > now() - INTERVAL '1h'",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "Error Spans (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "SELECT count(*) AS value FROM opentelemetry_traces WHERE span_status_code = 'STATUS_CODE_ERROR' AND timestamp > now() - INTERVAL '1h'",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "Services (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "SELECT count(DISTINCT service_name) AS value FROM opentelemetry_traces WHERE timestamp > now() - INTERVAL '1h'",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "table",
      "title": "Recent Traces",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "SELECT trace_id, span_name, service_name, span_status_code, duration_nano / 1000000 AS duration_ms, timestamp FROM opentelemetry_traces ORDER BY timestamp DESC LIMIT 50",
          "refId": "A",
          "format": "table"
        }
      ]
    }
  ]
}
