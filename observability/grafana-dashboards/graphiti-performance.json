{
  "title": "Graphiti Performance",
  "uid": "graphiti-performance",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "Trace ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "info": "Enter a trace_id to filter trace/log panels below"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphiti_api_requests_total[$__rate_interval]))",
          "legendFormat": "req/s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphiti_api_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(graphiti_api_requests_total[$__rate_interval])), 0.001) * 100",
          "legendFormat": "errors %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Search p95 Latency",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(graphiti_search_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Episode Add p95 Latency",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(graphiti_episode_add_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10000
              },
              {
                "color": "red",
                "value": 30000
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Route",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphiti_api_requests_total[$__rate_interval])) by(route) > 0",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API Latency (p50 / p95 / p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le)(rate(graphiti_api_request_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(graphiti_api_request_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(graphiti_api_request_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Search Latency (p50 / p95 / p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le)(rate(graphiti_search_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(graphiti_search_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(graphiti_search_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Episode Add Latency (p50 / p95 / p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "greptimedb-promql"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le)(rate(graphiti_episode_add_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(graphiti_episode_add_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(graphiti_episode_add_duration_ms_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "table",
      "title": "Slowest Spans",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT span_name, round(max(duration_nano)/1000000, 0) AS max_ms, round(avg(duration_nano)/1000000, 0) AS avg_ms, count(*) AS calls FROM opentelemetry_traces WHERE $__timeFilter(timestamp) AND ('${trace_id}' = '' OR trace_id = '${trace_id}') AND span_name LIKE 'graphiti.%' GROUP BY span_name ORDER BY max_ms DESC LIMIT 15"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent Traces",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT trace_id, span_name, round(duration_nano/1000000, 0) AS duration_ms, span_status_code AS status, timestamp FROM opentelemetry_traces WHERE $__timeFilter(timestamp) AND ('${trace_id}' = '' OR trace_id = '${trace_id}') AND span_name IN ('graphiti.add_episode', 'graphiti.search', 'http.server.request') ORDER BY timestamp DESC LIMIT 20"
        }
      ]
    },
    {
      "type": "table",
      "title": "Trace Waterfall",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT span_name, parent_span_id AS parent, span_id, round(duration_nano/1000000, 1) AS duration_ms, span_status_code AS status, \"span_attributes.model\" AS model, \"span_attributes.llm.provider\" AS llm_provider FROM opentelemetry_traces WHERE ('${trace_id}' = '' OR trace_id = '${trace_id}') ORDER BY timestamp ASC LIMIT 200"
        }
      ],
      "description": "Paste a trace_id in the Trace ID input at the top to see all spans in that trace, ordered by time."
    },
    {
      "type": "table",
      "title": "Server Logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT severity_text AS level, body AS message, trace_id, scope_name AS module, timestamp FROM graphiti_logs WHERE $__timeFilter(timestamp) AND ('${trace_id}' = '' OR trace_id = '${trace_id}') ORDER BY timestamp DESC LIMIT 100"
        }
      ]
    }
  ]
}