# Graphiti Server Environment Configuration
# Mirrors the MCP server config for consistency.

# === LLM Configuration (OpenAI-compatible) ===
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
USE_GENERIC_CLIENT=false
OPENAI_MAX_TOKENS=16384
LLM_TIMEOUT=600

# === Embedder Configuration ===
# Use 'bge_zh' for local BAAI/bge-large-zh-v1.5 (1024d) embedder
# Use 'openai' and set EMBEDDING_API_URL for a remote OpenAI-compatible embedding service
EMBEDDER_PROVIDER=bge_zh
EMBEDDING_API_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# === PostgreSQL AGE Database ===
DATABASE_PROVIDER=postgres_age
POSTGRES_AGE_DSN=postgresql://graphiti:graphiti@localhost:55432/graphiti
POSTGRES_AGE_GRAPH_NAME=graphiti
POSTGRES_AGE_EMBEDDING_DIMENSION=1024

# === Server ===
PORT=8000

# === Telemetry ===
GRAPHITI_TELEMETRY_ENABLED=false
