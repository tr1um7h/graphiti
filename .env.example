# ============================================================
# Graphiti Docker Compose 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ------------------------------------------------------------
# LLM 配置（必填）
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL_NAME=MiniMax-M2.7
USE_GENERIC_CLIENT=true
# 推理模型（如 MiniMax-M2.7）需要足够大的 token 预算，否则
# 推理过程耗尽 token 后只返回空响应，导致实体抽取校验失败
OPENAI_MAX_TOKENS=16384
# LLM 请求超时（秒），推理模型可适当调大
LLM_TIMEOUT=600

# ------------------------------------------------------------
# Embedding 配置 — 本地已启动的 embedding-service
# 默认使用 host.docker.internal 访问宿主机上的 embedding 服务
# ------------------------------------------------------------
EMBEDDING_API_URL=http://host.docker.internal:8080/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDER_PROVIDER=bge_zh

# ------------------------------------------------------------
# PostgreSQL AGE 数据库配置
# 本地开发：postgresql://graphiti:graphiti@localhost:55432/graphiti
# Docker 容器：postgresql://graphiti:graphiti@host.docker.internal:55432/graphiti
# ------------------------------------------------------------
POSTGRES_AGE_DSN=postgresql://graphiti:graphiti@host.docker.internal:55432/graphiti
POSTGRES_AGE_GRAPH_NAME=graphiti
POSTGRES_AGE_EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------
# 服务端口配置
# ------------------------------------------------------------
SERVER_PORT=8000
MCP_PORT=8001
WEB_PORT=3000

# ------------------------------------------------------------
# MCP Server 配置
# ------------------------------------------------------------
GRAPHITI_GROUP_ID=main
SEMAPHORE_LIMIT=10
