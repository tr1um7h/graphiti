# ─── Backend Services (通过 docker-compose 注入) ───
PYTHON_API_URL=http://host.docker.internal:8000
GRAPHITI_MCP_URL=http://host.docker.internal:8001

# ─── Web Service ───
PORT=3000
NODE_ENV=production
# ─── Backend Services ───
PYTHON_API_URL=http://localhost:8000
GRAPHITI_MCP_URL=http://localhost:8000
COGNEE_API_URL=http://localhost:8001

# ─── Database (PostgreSQL + AGE + pgvector) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graphdb
AGE_GRAPH_NAME=graphiti_mcp

# ─── LLM ───
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://api.deepseek.com/chat/completions

# ─── Embedder (MiniLM local Docker) ───
EMBEDDER_API_URL=http://localhost:8080/v1
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER_DIMENSIONS=384

# ─── Graphiti ───
GRAPHITI_GROUP_ID=mcp_demo_group
GRAPHITI_USER_ID=mcp_user
