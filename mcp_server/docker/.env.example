# Graphiti MCP Server 环境配置 (Oracle Linux 部署)
# 复制此文件为 .env 并填写实际配置值

# ===== PostgreSQL AGE（外部服务）=====
POSTGRES_AGE_DSN=postgresql://graphiti:graphiti@your-pg-host:5432/graphiti
POSTGRES_AGE_GRAPH_NAME=graphiti
POSTGRES_AGE_EMBEDDING_DIMENSION=384

# ===== LLM 配置 (OpenAI 兼容) =====
OPENAI_API_KEY=your-internal-api-key
OPENAI_BASE_URL=http://your-internal-llm-endpoint/v1
OPENAI_MODEL_NAME=MiniMax-M2.7

# ===== 嵌入模型配置 (远程 OpenAI 兼容) =====
EMBEDDING_API_URL=http://your-internal-embedding-endpoint/v1

# ===== 应用配置 =====
GRAPHITI_GROUP_ID=main
SEMAPHORE_LIMIT=10
MCP_PORT=8800
